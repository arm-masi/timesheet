# ========================================
# Timesheet Management - Environment Config
# ========================================
# Copy this file to .env and fill in values

# --- Database ---
# These match docker-compose defaults; change for production
POSTGRES_DB=timesheet
POSTGRES_USER=timesheet
POSTGRES_PASSWORD=timesheet

# --- JWT ---
# IMPORTANT: Change this to a strong random key in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production-use-a-strong-random-key

# --- Azure AD / Entra ID (SSO Microsoft 365) ---
# Leave empty to disable SSO (local admin login still works)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Admin locale ---
# Password iniziale per l'utente admin locale
ADMIN_DEFAULT_PASSWORD=admin
